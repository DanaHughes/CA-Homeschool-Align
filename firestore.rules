rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Only Dana's account may read or manage in-app messages.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'dana2andrea@gmail.com';
    }

    // Users collection - a person may read and update their own record, but may NOT change anything that
    // decides who has paid or how much free use they have. Only the server (which skips these rules) does that.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.isPaid == false &&
        request.resource.data.accountTier == 'free' &&
        request.resource.data.subscriptionPlan == 'none' &&
        !request.resource.data.keys().hasAny(['proUntil', 'paidAt', 'accessCodeUsed', 'stripeCustomerId', 'stripeSubscriptionId']);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPaid', 'accountTier', 'paidAt', 'accessCodeUsed', 'subscriptionPlan',
          'stripeCustomerId', 'stripeSubscriptionId', 'proUntil', 'searchCount', 'trialStartedAt'
        ]);
      allow delete: if isOwner(userId);
    }

    // Free trial records: written only by the server. Each person may read their own to see what is left.
    match /trials/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    
    // Students collection - a family can only see and change its OWN students.
    // (A "list" must be filtered by userId, so nobody can ask for everyone's students.)
    match /students/{studentId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Records collection - same rule: only the family's own records.
    match /records/{recordId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Generation history - every generated work sample, private to the family that made it.
    match /generations/{generationId} {
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Feature requests collection - users can create and read their own requests
    match /feature_requests/{requestId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // In-app messages (bug reports): anyone signed in can send one as themselves;
    // only the admin can read, mark handled, or delete.
    match /messages/{messageId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // Settings (for example the words on the payment screen): anyone signed in can read,
    // only the admin can change them. The wording document "siteText" is also readable before
    // sign-in, because the sign-in page shows it.
    match /settings/{docId} {
      allow read: if isAuthenticated() || docId == 'siteText';
      allow write: if isAdmin();
    }

    // The old browser-side usage counter is no longer used (limits are enforced on the server).
    match /system_stats/{statId} {
      allow read, write: if false;
    }
  }
}
