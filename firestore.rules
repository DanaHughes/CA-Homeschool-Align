rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Only Dana's account may read or manage in-app messages.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'dana2andrea@gmail.com';
    }

    // Users collection - users can read/update their own user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Students collection - users can only access their own students
    match /students/{studentId} {
      // Allow list queries - Firestore will only return documents that pass the read rule below
      allow list: if isAuthenticated();
      
      // Allow read/write of individual documents if userId matches
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if userId matches
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Records collection - users can only access records for their own students
    match /records/{recordId} {
      // Allow list queries - Firestore will only return documents that pass the read rule below
      allow list: if isAuthenticated();
      
      // Allow read if the record's userId matches the authenticated user
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow write (update/delete) if userId matches
      allow write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if userId matches
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Feature requests collection - users can create and read their own requests
    match /feature_requests/{requestId} {
      allow list: if isAuthenticated();
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // In-app messages (bug reports): anyone signed in can send one as themselves;
    // only the admin can read, mark handled, or delete.
    match /messages/{messageId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // System stats collection - allow authenticated users to read and write (for usage tracking)
    match /system_stats/{statId} {
      allow read, write: if isAuthenticated();
    }
  }
}
