# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored and is picked up automatically by Vite.
# After editing, restart the dev server (`npm run dev`).

# --- Firebase (Web app config) ---
# From Firebase Console → Project Settings → General → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ca-homeschool-align.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ca-homeschool-align
VITE_FIREBASE_STORAGE_BUCKET=ca-homeschool-align.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=139982618318
VITE_FIREBASE_APP_ID=1:139982618318:web:f156a849ef383dd1b95a9f

# --- Gemini (AI Studio) ---
# Used by services/geminiService.ts for AI standard-matching.
API_KEY=

# --- Optional: Access gate ---
# Defaults to "TEACH2024" if unset.
VITE_ACCESS_CODE=
